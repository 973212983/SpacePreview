{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  },
  "app": {
    "windows": [
      {
        "title": "瞬览 · SpacePreview",
        "label": "main",
        "width": 1000,
        "height": 760,
        "minWidth": 320,
        "minHeight": 240,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ]
  }
}
